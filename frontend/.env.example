# 前端构建变量（公开，禁止写入任何秘密）
# 后端 API 基础地址，例如 http://127.0.0.1:8000
VITE_API_BASE_URL=
# 已发布的 NK-GeniOS 主 Agent 链接；未配置时“返回 NK-GeniOS”按钮禁用
VITE_GENIOS_AGENT_URL=
# 只读内容站构建设为 true；身份站构建设为 false
VITE_PUBLIC_CONTENT_ONLY=false
VITE_IDENTITY_PILOT=false
# 身份站的地图入口指向公开内容站；公开内容站的课表入口指向身份站
# 只填服务 origin，禁止含令牌、账号密码或查询参数
VITE_PUBLIC_CONTENT_ORIGIN=
VITE_TIMETABLE_ORIGIN=
