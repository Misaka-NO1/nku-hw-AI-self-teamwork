    "TermCalendar": {"type":"object","properties":{"term_id":{"type":"string","minLength":1,"maxLength":128},"timezone":{"const":"Asia/Shanghai"},"week1_monday":{"type":"string","format":"date"},"teaching_weeks":{"type":"integer","minimum":1,"maximum":60},"calendar_status":{"enum":["demo","official_verified","user_confirmed","needs_confirmation"]},"periods":{"type":"array","items":{"type":"object","properties":{"period":{"type":"integer","minimum":1},"start":{"type":"string","pattern":"^([01]\\d|2[0-3]):[0-5]\\d$"},"end":{"type":"string","pattern":"^([01]\\d|2[0-3]):[0-5]\\d$"}},"required":["period","start","end"],"additionalProperties":false},"minItems":1},"overrides":{"type":"array","items":{"type":"object","properties":{"date":{"type":"string","format":"date"},"action":{"enum":["cancel","replace"]},"teaching_week":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},"weekday":{"anyOf":[{"type":"integer","minimum":1,"maximum":7},{"type":"null"}]},"source_ref":{"type":"string"}},"required":["date","action","teaching_week","weekday","source_ref"],"additionalProperties":false}},"source_ref":{"type":"string"}},"required":["term_id","timezone","week1_monday","teaching_weeks","calendar_status","periods","overrides","source_ref"],"additionalProperties":false},
    "Coverage": {"type":"object","properties":{"scope":{"enum":["term","selected_weeks","unknown"]},"week_numbers":{"type":"array","items":{"type":"integer","minimum":1},"uniqueItems":true},"completeness":{"enum":["complete","partial","unknown"]}},"required":["scope","week_numbers","completeness"],"additionalProperties":false},
    "Meeting": {"type":"object","properties":{"meeting_id":{"type":"string","minLength":1,"maxLength":128},"weekday":{"type":"integer","minimum":1,"maximum":7},"weeks":{"type":"array","items":{"type":"integer","minimum":1},"uniqueItems":true,"minItems":1},"start_period":{"type":"integer","minimum":1},"end_period":{"type":"integer","minimum":1},"location":{"anyOf":[{"type":"string"},{"type":"null"}]},"campus_id":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["meeting_id","weekday","weeks","start_period","end_period","location","campus_id"],"additionalProperties":false},
    "Course": {"type":"object","properties":{"course_id":{"type":"string","minLength":1,"maxLength":128},"course_code":{"anyOf":[{"type":"string"},{"type":"null"}]},"offering_id":{"type":"string","minLength":1,"maxLength":128},"title":{"type":"string"},"credits":{"anyOf":[{"type":"string","pattern":"^\\d+(\\.\\d{1,2})?$"},{"type":"null"}]},"teacher_display":{"anyOf":[{"type":"string"},{"type":"null"}]},"meetings":{"type":"array","items":{"$ref":"#/$defs/Meeting"},"minItems":1}},"required":["course_id","course_code","offering_id","title","credits","teacher_display","meetings"],"additionalProperties":false},
