    "ScenicSpot": {"type":"object","properties":{"spot_id":{"type":"string","minLength":1,"maxLength":128},"map_id":{"type":"string","minLength":1,"maxLength":128},"name":{"type":"string"},"x_norm":{"type":"number","minimum":0,"maximum":1},"y_norm":{"type":"number","minimum":0,"maximum":1},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true},"description":{"type":"string"},"photos":{"type":"array","items":{"type":"object","properties":{"photo_id":{"type":"string","minLength":1,"maxLength":128},"asset_path":{"anyOf":[{"type":"string"},{"type":"null"}]},"caption":{"type":"string"},"captured_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"rights_status":{"enum":["owned","authorized","public_link_only","pending"]}},"required":["photo_id","asset_path","caption","captured_at","rights_status"],"additionalProperties":false}},"historical_bloom_months":{"type":"array","items":{"type":"integer","minimum":1,"maximum":12},"uniqueItems":true},"observation":{"anyOf":[{"type":"object","properties":{"observed_at":{"type":"string","format":"date-time"},"status":{"type":"string"},"source_ref":{"type":"string"}},"required":["observed_at","status","source_ref"],"additionalProperties":false},{"type":"null"}]},"rights_status":{"enum":["owned","authorized","public_link_only","pending"]},"data_status":{"enum":["demo","verified","needs_verification"]}},"required":["spot_id","map_id","name","x_norm","y_norm","tags","description","photos","historical_bloom_months","observation","rights_status","data_status"],"additionalProperties":false},
