    "FreeTimeQuery": {"type":"object","properties":{"workspace_ref":{"type":"string","minLength":1,"maxLength":128},"window":{"$ref":"#/$defs/TimeWindow"},"min_minutes":{"type":"integer","minimum":1,"maximum":1440},"buffers":{"$ref":"#/$defs/Buffers"}},"required":["workspace_ref","window","min_minutes","buffers"],"additionalProperties":false},
    "TimeCheckRequest": {"type":"object","properties":{"workspace_ref":{"type":"string","minLength":1,"maxLength":128},"kind":{"enum":["event_conflict","deadline_feasibility"]},"window":{"$ref":"#/$defs/TimeWindow"},"event":{"anyOf":[{"$ref":"#/$defs/EventTime"},{"type":"null"}]},"due":{"anyOf":[{"$ref":"#/$defs/DueTime"},{"type":"null"}]},"estimated_minutes":{"anyOf":[{"type":"integer","minimum":1,"maximum":10080},{"type":"null"}]},"earliest_start":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"allow_split":{"const":false},"buffers":{"$ref":"#/$defs/Buffers"}},"required":["workspace_ref","kind","window","event","due","estimated_minutes","earliest_start","allow_split","buffers"],"additionalProperties":false},
    "ScenicQuery": {"type":"object","properties":{"campus_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true},"month":{"anyOf":[{"type":"integer","minimum":1,"maximum":12},{"type":"null"}]},"limit":{"type":"integer","minimum":1,"maximum":20}},"required":["campus_id","tags","month","limit"],"additionalProperties":false},
    "StudyQuery": {"type":"object","properties":{"course_id":{"type":"string","minLength":1,"maxLength":128},"topic":{"anyOf":[{"type":"string"},{"type":"null"}]},"limit":{"type":"integer","minimum":1,"maximum":20}},"required":["course_id","topic","limit"],"additionalProperties":false},
    "TaskDraftRequest": {"type":"object","properties":{"workspace_ref":{"type":"string","minLength":1,"maxLength":128},"notice":{"$ref":"#/$defs/NoticeDraft"}},"required":["workspace_ref","notice"],"additionalProperties":false},
    "TaskStatusQuery": {"type":"object","properties":{"workspace_ref":{"type":"string","minLength":1,"maxLength":128},"task_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"draft_id":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["workspace_ref","task_id","draft_id"],"additionalProperties":false}
