    "StudyCatalog": {"type":"object","properties":{"schema_version":{"const":"1.0.0"},"data_version":{"type":"string","minLength":1,"maxLength":128},"materials":{"type":"array","items":{"$ref":"#/$defs/StudyMaterial"}}},"required":["schema_version","data_version","materials"],"additionalProperties":false},
    "DegreePlan": {"type":"object","properties":{"schema_version":{"const":"1.0.0"},"dataset_kind":{"enum":["demo","personal"]},"plan_id":{"type":"string","minLength":1,"maxLength":128},"program":{"type":"string"},"cohort":{"type":"string"},"version":{"type":"string"},"status":{"enum":["demo","official_verified","needs_verification"]},"source_ref":{"type":"string"},"repeat_policy":{"anyOf":[{"enum":["once_per_course"]},{"type":"null"}]},"modules":{"type":"array","items":{"type":"object","properties":{"module_id":{"type":"string","minLength":1,"maxLength":128},"required_course_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128},"uniqueItems":true},"eligible_course_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128},"uniqueItems":true},"min_credits":{"type":"string","pattern":"^\\d+(\\.\\d{1,2})?$"},"allocation_priority":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]}},"required":["module_id","required_course_ids","eligible_course_ids","min_credits","allocation_priority"],"additionalProperties":false},"minItems":1}},"required":["schema_version","dataset_kind","plan_id","program","cohort","version","status","source_ref","repeat_policy","modules"],"additionalProperties":false},
    "Transcript": {"type":"object","properties":{"schema_version":{"const":"1.0.0"},"dataset_kind":{"enum":["demo","personal"]},"transcript_id":{"type":"string","minLength":1,"maxLength":128},"records":{"type":"array","items":{"type":"object","properties":{"attempt_id":{"type":"string","minLength":1,"maxLength":128},"course_id":{"type":"string","minLength":1,"maxLength":128},"credits":{"type":"string","pattern":"^\\d+(\\.\\d{1,2})?$"},"result":{"enum":["passed","failed","in_progress","unknown"]}},"required":["attempt_id","course_id","credits","result"],"additionalProperties":false}}},"required":["schema_version","dataset_kind","transcript_id","records"],"additionalProperties":false},
    "TimeWindow": {"type":"object","properties":{"start":{"type":"string","format":"date-time"},"end":{"type":"string","format":"date-time"}},"required":["start","end"],"additionalProperties":false},
