    {
      "entry_id": "nku-proc-selfstudy",
      "kind": "procedure",
      "title": "本科生自修课程申请",
      "category": "academic",
      "campus_scope": [],
      "audience": ["本科生"],
      "official_url": "https://jwc.nankai.edu.cn/2022/0218/c35927a550802/page.htm",
      "login_required": "yes",
      "campus_network_required": "unknown",
      "steps": [
        "在补退选阶段内提交自修申请，并向任课教师说明自修情况，由任课教师审核；每学期自修课程不得超过 1 门",
        "登录教学管理信息系统→「我的」→「自修申请」，切换到相应学期后搜索课程",
        "已选课程：在「已选课程」中勾选后点击「申请自修」；时间冲突的两门课须先正常选一门，再对另一门申请自修",
        "已通过审核的自修课程，在补退选阶段不允许退课"
      ],
