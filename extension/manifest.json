{
  "manifest_version": 3,
  "name": "南开校园助手 · 教务课表读取",
  "version": "0.2.0",
  "description": "点击教务页读取按钮，将课程表格文本送到团队工具站核对；用户确认后保存本人课表。不读取密码、Cookie 或 SSO 字段，不自动上传保存。",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://eamis.nankai.edu.cn/eams/courseTableForStd*",
    "https://nku-campus-identity-pilot-308235-6-1467707525.sh.run.tcloudbase.com/tools/import*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "导入当前页课表"
  },
  "content_scripts": [
    {
      "matches": ["https://eamis.nankai.edu.cn/eams/courseTableForStd*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nku-campus-identity-pilot-308235-6-1467707525.sh.run.tcloudbase.com/tools/import*"
      ],
      "js": ["dist/app-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": []
}
