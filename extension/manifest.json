{
  "manifest_version": 3,
  "name": "南开校园助手 · 课表导入（开发版）",
  "version": "0.2.0",
  "description": "在教务课表页自动读取课程区域（仅白名单页面、仅课程表格文本），本地预览核对后导出或经短期票据上传；可自动回传到本地课表板块。不读取密码、Cookie、SSO 字段。",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://eamis.nankai.edu.cn/eams/courseTableForStd*",
    "http://localhost:7100/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:7100/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "导入当前页课表"
  },
  "content_scripts": [
    {
      "matches": ["https://eamis.nankai.edu.cn/eams/courseTableForStd*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:7100/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:7100/*"
      ],
      "js": ["dist/app-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": []
}
