# Frontend build-time variable; never put secrets here.
VITE_API_BASE_URL=

# Backend/runtime variables.
APP_ENV=development
BUILD_ID=dev
LOG_LEVEL=INFO
AUTH_MODE=demo_fixture
ALLOW_PERSONAL_UPLOADS=false
# Local fictional notice testing only; never enabled in the existing cloud package.
NOTICE_TEXT_PILOT_ENABLED=false
# Cloud notice backend candidate requires its separate reviewed PG migration.
CLOUD_NOTICE_TEXT_PILOT_ENABLED=false
# Calendar requires the separate calendar migration and the notice backend.
CLOUD_TASK_CALENDAR_ENABLED=false
NOTICE_OCR_BACKEND=disabled
# If explicitly configured for a Linux cloud candidate: absolute executable path.
NOTICE_OCR_COMMAND=
APP_ORIGIN=
GENIOS_AGENT_URL=
MCP_PUBLIC_URL=
MCP_SERVICE_TOKEN=
MCP_REQUIRE_AUTH=false
# Default probe-only; the separate read-only cloud bundle opts in with a verified manifest.
MCP_ENABLE_DOMAIN_TOOLS=false
# Opt-in JSON-text platform adapters; requires domain tools and a matching candidate manifest.
MCP_ENABLE_PLATFORM_COMPAT_TOOLS=false
# Opt-in JSON-text platform adapters; requires domain tools and a matching candidate manifest.
MCP_ENABLE_PLATFORM_COMPAT_TOOLS=false
# Package-only manifest; leave empty for the isolated local source-tree checks.
DOMAIN_BUNDLE_MANIFEST_PATH=
API_HOST=127.0.0.1
API_PORT=8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
DATABASE_URL=sqlite:///data/campus.db
IMPORT_TICKET_TTL_SECONDS=600
CONFIRMATION_TTL_SECONDS=600
DEMO_WORKSPACE_TTL_HOURS=24
NKU_ALLOWED_EDU_ORIGINS=[]
NKU_ALLOWED_EDU_PATHS=[]
