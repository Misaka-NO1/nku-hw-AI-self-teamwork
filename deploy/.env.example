# Frontend build-time variable; never put secrets here.
VITE_API_BASE_URL=

# Backend/runtime variables.
APP_ENV=development
BUILD_ID=dev
LOG_LEVEL=INFO
AUTH_MODE=demo_fixture
ALLOW_PERSONAL_UPLOADS=false
APP_ORIGIN=
GENIOS_AGENT_URL=
MCP_PUBLIC_URL=
MCP_SERVICE_TOKEN=
MCP_REQUIRE_AUTH=false
API_HOST=127.0.0.1
API_PORT=8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
DATABASE_URL=sqlite:///data/campus.db
IMPORT_TICKET_TTL_SECONDS=600
CONFIRMATION_TTL_SECONDS=600
DEMO_WORKSPACE_TTL_HOURS=24
NKU_ALLOWED_EDU_ORIGINS=[]
NKU_ALLOWED_EDU_PATHS=[]
