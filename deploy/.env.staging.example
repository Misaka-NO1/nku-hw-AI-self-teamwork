# Template only. Not an active deployment. Supply secrets through protected server configuration.
APP_ENV=staging
BUILD_ID=
LOG_LEVEL=INFO
AUTH_MODE=demo_fixture
ALLOW_PERSONAL_UPLOADS=false
APP_ORIGIN=
GENIOS_AGENT_URL=
