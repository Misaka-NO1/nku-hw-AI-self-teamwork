# Set sqlite:/// followed by ONE ABSOLUTE persistent file path shared by both processes.
# Example syntax only: sqlite:////srv/campus-data/campus.db (Linux).
# Actual server path must be confirmed before use. Do not use an in-memory database.
DATABASE_URL=
IMPORT_TICKET_TTL_SECONDS=600
CONFIRMATION_TTL_SECONDS=600
DEMO_WORKSPACE_TTL_HOURS=24
NKU_ALLOWED_EDU_ORIGINS=[]
NKU_ALLOWED_EDU_PATHS=[]
